{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:node": "ESTATEHUB_TARGET=node vinext build",
    "check:locales": "node scripts/audit-buyer-locales.mjs",
    "check:roles": "node scripts/verify-role-access.mjs",
    "check:migrations": "python3 scripts/check-migrations.py",
    "db:migrate:pg": "node scripts/migrate-postgres.mjs",
    "check:orgs": "python3 scripts/verify-org-isolation.py",
    "check:platform-isolation": "python3 scripts/verify-platform-role-isolation.py",
    "check:risk": "node --experimental-strip-types scripts/verify-verification-risk.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:node": "ESTATEHUB_TARGET=node vinext start --host 0.0.0.0 --port 3000",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "redis": "^6.2.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
